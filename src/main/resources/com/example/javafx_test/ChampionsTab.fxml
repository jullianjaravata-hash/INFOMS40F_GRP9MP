<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="720.0" prefWidth="1030.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx_test.ChampionsController">
   <children>
      <VBox fx:id="championsMain" prefHeight="441.0" prefWidth="548.0">
         <children>
            <Label prefHeight="50.0" prefWidth="180.0" text="Champions">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <font>
                  <Font size="36.0" />
               </font>
            </Label>
            <Label prefHeight="30.0" prefWidth="90.0" text="N Records">
               <font>
                  <Font size="17.0" />
               </font>
            </Label>
            <HBox prefHeight="80.0" prefWidth="462.0">
               <children>
                  <ComboBox maxWidth="1.7976931348623157E308" prefHeight="60.0" prefWidth="200.0" promptText="Filter By Class">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </ComboBox>
                  <Button mnemonicParsing="false" onAction="#addChampions" prefHeight="50.0" prefWidth="150.0" text="Add Champion">
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" text="Update">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="150.0" text="Delete">
                     <font>
                        <Font size="18.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="5.0" right="5.0" top="5.0" />
                     </HBox.margin>
                  </Button>
               </children>
               <padding>
                  <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
               </padding>
            </HBox>
            <TableView fx:id="championTable" prefHeight="450.0" prefWidth="462.0">
               <columns>
                  <TableColumn fx:id="Code" prefWidth="100.0" text="Code" />
                  <TableColumn fx:id="Name" prefWidth="100.0" text="Name" />
                  <TableColumn fx:id="Title" prefWidth="200.0" text="Title" />
                  <TableColumn fx:id="Class" prefWidth="150.0" text="Class" />
                  <TableColumn fx:id="Resource" prefWidth="100.0" text="Resource" />
                  <TableColumn fx:id="HP" prefWidth="100.0" text="HP" />
                  <TableColumn fx:id="Range" prefWidth="100.0" text="Range" />
                  <TableColumn fx:id="Active" prefWidth="100.0" text="Status" />
               </columns>
            </TableView>
         </children>
      </VBox>
      <VBox fx:id="addChampionView" prefHeight="200.0" prefWidth="100.0" visible="false">
         <children>
            <Label text="Add New Champion">
               <font>
                  <Font size="37.0" />
               </font>
            </Label>
            <Label text="Fill in the fields.">
               <font>
                  <Font size="20.0" />
               </font>
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Label>
            <GridPane prefHeight="400.0" prefWidth="900.0">
               <columnConstraints>
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                  <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
               </columnConstraints>
               <rowConstraints>
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               </rowConstraints>
               <children>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="432.0">
                     <children>
                        <Label text="Champion Name">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                     <GridPane.margin>
                        <Insets />
                     </GridPane.margin>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1">
                     <children>
                        <Label text="Champion Title">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Class">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <ComboBox prefHeight="40.0" prefWidth="200.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Resource Type">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="2">
                     <children>
                        <Label text="Base HP">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                     <children>
                        <Label text="Range">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.rowIndex="3">
                     <children>
                        <Label text="Release Date">
                           <font>
                              <Font size="20.0" />
                           </font>
                        </Label>
                        <TextField prefHeight="40.0" prefWidth="350.0" />
                     </children>
                  </VBox>
                  <VBox fillWidth="false" prefHeight="200.0" prefWidth="100.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                     <children>
                        <ToggleButton mnemonicParsing="false" prefHeight="40.0" prefWidth="200.0" text="Active">
                           <VBox.margin>
                              <Insets top="20.0" />
                           </VBox.margin>
                           <font>
                              <Font size="23.0" />
                           </font>
                        </ToggleButton>
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets left="5.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </GridPane>
            <HBox prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" prefHeight="50.0" prefWidth="200.0" text="Save">
                     <font>
                        <Font size="24.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#returnMainView" prefHeight="50.0" prefWidth="200.0" text="Back (Cancel)">
                     <font>
                        <Font size="24.0" />
                     </font>
                     <HBox.margin>
                        <Insets left="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
</StackPane>
