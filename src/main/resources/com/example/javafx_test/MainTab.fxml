<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainTab" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.javafx_test.MainController">
    <left>
        <VBox prefHeight="720.0" prefWidth="250.0" BorderPane.alignment="CENTER">
            <children>
                <Label prefHeight="50.0" prefWidth="140.0" text="LoL Tracker">
                    <font>
                        <Font size="26.0" />
                    </font>
                </Label>
                <Button fx:id="Home" mnemonicParsing="false" prefHeight="60.0" prefWidth="130.0" text="Home">
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="20.0" />
                    </VBox.margin>
                    <font>
                        <Font size="20.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToChampions" prefHeight="60.0" prefWidth="130.0" text="Champions">
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                    </VBox.margin>
                    <font>
                        <Font size="20.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToAbilities" prefHeight="60.0" prefWidth="130.0" text="Abilities">
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                    </VBox.margin>
                    <font>
                        <Font size="20.0" />
                    </font>
                </Button>
                <Button mnemonicParsing="false" onAction="#switchToStats" prefHeight="60.0" prefWidth="130.0" text="Stats">
                    <VBox.margin>
                        <Insets bottom="5.0" left="10.0" top="5.0" />
                    </VBox.margin>
                    <font>
                        <Font size="20.0" />
                    </font>
                </Button>
            </children>
            <opaqueInsets>
                <Insets />
            </opaqueInsets>
            <padding>
                <Insets left="10.0" top="15.0" />
            </padding>
        </VBox>
    </left>
    <opaqueInsets>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </opaqueInsets>
</BorderPane>
